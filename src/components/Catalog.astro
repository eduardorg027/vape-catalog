---
import { products, categories } from '../data/products.js';
import ProductCard from './ProductCard.astro';
---

<section id="catalogo" class="mx-auto max-w-6xl px-6 py-16">
  <h2 class="text-center text-3xl font-black md:text-4xl">
    Nuestro <span class="bg-gradient-to-r from-neon to-aqua bg-clip-text text-transparent">catálogo</span>
  </h2>
  <p class="mt-3 text-center text-white/50">Explora por categoría y consulta disponibilidad por WhatsApp.</p>

  <!-- Tabs -->
  <div class="mt-10 flex flex-wrap justify-center gap-2">
    {
      categories.map((cat, i) => (
        <button
          class:list={[
            'tab-btn rounded-full border px-5 py-2 text-sm font-semibold transition',
            i === 0
              ? 'border-transparent bg-gradient-to-r from-neon to-aqua text-night'
              : 'border-white/15 bg-white/5 text-white/70 hover:bg-white/10',
          ]}
          data-filter={cat.id}
        >
          {cat.icon} {cat.label}
        </button>
      ))
    }
  </div>

  <!-- Grid -->
  <div id="product-grid" class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
    {products.map((p) => <ProductCard product={p} />)}
  </div>
</section>

<script>
  const buttons = document.querySelectorAll('.tab-btn');
  const cards = document.querySelectorAll('.product-card');

  const activeClasses = ['border-transparent', 'bg-gradient-to-r', 'from-neon', 'to-aqua', 'text-night'];
  const inactiveClasses = ['border-white/15', 'bg-white/5', 'text-white/70'];

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter;

      buttons.forEach((b) => {
        b.classList.remove(...activeClasses);
        b.classList.add(...inactiveClasses);
      });
      btn.classList.remove(...inactiveClasses);
      btn.classList.add(...activeClasses);

      cards.forEach((card) => {
        const show = filter === 'todos' || card.dataset.categoria === filter;
        card.classList.toggle('hidden', !show);
      });
    });
  });
</script>
