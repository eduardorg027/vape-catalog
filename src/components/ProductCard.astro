---
import { whatsappLink, siteConfig } from '../data/config.js';

const { product } = Astro.props;

const badgeStyles = {
  nuevo: 'border-acid/40 bg-acid/15 text-accent',
  top: 'border-line bg-elev text-bone',
  agotado: 'border-red-500/40 bg-red-500/15 text-red-500',
};
const badgeLabels = { nuevo: 'Nuevo', top: 'Top ventas', agotado: 'Agotado' };
const agotado = product.badge === 'agotado' || product.cantidad === 0;
const unidades = product.cantidad ?? null;
const pocasPiezas = unidades !== null && unidades > 0 && unidades <= 3;
---

<article
  class:list={[
    'product-card group relative flex cursor-pointer flex-col overflow-hidden rounded-2xl border border-line bg-surface/70 p-3 backdrop-blur transition-all duration-300 hover:-translate-y-1.5 hover:border-acid/50 hover:shadow-glow',
    { 'opacity-55 saturate-50': agotado },
  ]}
  data-categoria={product.categoria}
  data-search={`${product.nombre} ${product.descripcion} ${product.sabor || ''}`.toLowerCase()}
  data-product={JSON.stringify(product)}
>
  <!-- Imagen con bordes redondeados -->
  <div class="relative aspect-[4/3] overflow-hidden rounded-xl border border-line bg-elev">
    {
      product.imagen ? (
        <img
          src={product.imagen}
          alt={product.nombre}
          loading="lazy"
          class="h-full w-full object-contain p-4 transition-transform duration-500 ease-out group-hover:scale-[1.08]"
        />
      ) : (
        <span class="absolute inset-0 flex items-center justify-center text-6xl opacity-20 transition-transform duration-500 group-hover:scale-110">
          💨
        </span>
      )
    }

    {
      product.badge && (
        <span
          class={`absolute left-3 top-3 rounded-full border px-2.5 py-1 text-[10px] font-bold uppercase tracking-widest backdrop-blur ${badgeStyles[product.badge]}`}
        >
          {badgeLabels[product.badge]}
        </span>
      )
    }
  </div>

  <!-- Info -->
  <div class="flex flex-1 flex-col px-1 pb-1 pt-4">
    <h3 class="text-[15px] font-bold leading-snug tracking-tight text-bone">
      {product.nombre}
    </h3>
    <p class="mt-1.5 line-clamp-2 text-[13px] leading-relaxed text-bone/45">{product.descripcion}</p>

    <!-- Especificaciones -->
    <div class="mt-3 flex flex-wrap gap-1.5">
      {
        product.sabor && (
          <span class="rounded-md border border-acid/30 bg-acid/10 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-accent">
            Sabor: {product.sabor}
          </span>
        )
      }
      {
        product.puffs && (
          <span class="rounded-md border border-line bg-elev px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-bone/60">
            Puffs: {product.puffs.toLocaleString('es-MX')}
          </span>
        )
      }
      {
        unidades !== null && (
          <span
            class:list={[
              'rounded-md border px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider',
              unidades === 0
                ? 'border-red-500/30 bg-red-500/10 text-red-500'
                : pocasPiezas
                  ? 'border-acid/40 bg-acid/15 text-accent'
                  : 'border-line bg-elev text-bone/60',
            ]}
          >
            {unidades === 0 ? 'Agotado' : pocasPiezas ? `¡Últimas ${unidades}!` : `Cantidad: ${unidades}`}
          </span>
        )
      }
    </div>

    <div class="mt-4 flex items-end justify-between gap-3 border-t border-line pt-4">
      {
        product.precio != null ? (
          <p class="text-2xl font-black leading-none tracking-tight text-accent">
            <span class="align-top text-sm font-bold">{siteConfig.moneda}</span>{product.precio.toLocaleString('es-MX')}
          </p>
        ) : (
          <p class="text-sm font-bold uppercase tracking-wider text-bone/45">Precio a consultar</p>
        )
      }

      {
        !agotado ? (
          <a
            href={whatsappLink(product)}
            target="_blank"
            rel="noopener"
            class="rounded-lg border border-line bg-elev px-3.5 py-2 text-xs font-bold text-bone/90 transition hover:border-acid/45 hover:bg-acid/15 hover:text-accent"
          >
            Consultar
          </a>
        ) : (
          <span class="text-xs font-semibold uppercase tracking-wider text-bone/30">Sin stock</span>
        )
      }
    </div>
  </div>
</article>
