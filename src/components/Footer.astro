---
import { siteConfig } from '../data/config.js';
---

<footer class="border-t border-line px-5 py-12 sm:px-6">
  <div class="mx-auto max-w-6xl">
    <div class="flex flex-col items-center gap-8 md:flex-row md:items-start md:justify-between">
      <div class="text-center md:text-left">
        <div class="flex items-center justify-center gap-2.5 md:justify-start">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-acid text-sm text-onacid">💀</span>
          <span class="font-display text-base uppercase tracking-wide">{siteConfig.nombre}</span>
        </div>
        <p class="mt-3 max-w-xs text-xs leading-relaxed text-bone/35">
          {siteConfig.tagline}. Productos de vapeo para mayores de edad.
        </p>
      </div>

      <div class="w-full max-w-sm rounded-2xl border border-line p-4">
        <p class="text-[11px] font-bold uppercase tracking-widest text-bone/45">🔞 Advertencia</p>
        <p class="mt-2 text-xs leading-relaxed text-bone/40">
          Productos destinados exclusivamente a mayores de 18 años. La nicotina es una sustancia adictiva.
          No recomendado para embarazadas ni personas con condiciones cardíacas.
        </p>
      </div>
    </div>

    <div
      class="mt-10 flex flex-col items-center justify-between gap-2 border-t border-line pt-6 text-[11px] text-bone/30 md:flex-row"
    >
      <p>© {new Date().getFullYear()} {siteConfig.nombre}. Todos los derechos reservados.</p>
      <p>Hecho en México</p>
    </div>
  </div>
</footer>
