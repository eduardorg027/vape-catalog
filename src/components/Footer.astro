---
import { siteConfig } from '../data/config.js';
---

<footer class="border-t border-white/10 py-10">
  <div class="mx-auto max-w-6xl px-6 text-center text-sm text-white/40">
    <p class="font-semibold text-white/60">{siteConfig.nombre} · {siteConfig.tagline}</p>
    <p class="mt-3">
      🔞 Productos destinados exclusivamente a mayores de 18 años. El consumo de nicotina es adictivo.
    </p>
    <p class="mt-1">© {new Date().getFullYear()} {siteConfig.nombre}. Todos los derechos reservados.</p>
  </div>
</footer>
