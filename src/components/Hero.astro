---
import { siteConfig } from '../data/config.js';
import { products } from '../data/products.js';
import ThemeToggle from './ThemeToggle.astro';

const marcas = ['Elf Bar', 'Lost Mary', 'Geek Bar', 'Waka', 'NEXA', 'Vaporesso', 'Elux', 'HQD'];
const totalProductos = products.length;
---

<header class="relative overflow-hidden">
  <!-- Único resplandor de fondo, mismo tono que el acento -->
  <div
    class="pointer-events-none absolute left-1/2 top-0 h-72 w-[40rem] -translate-x-1/2 rounded-full bg-acid/[0.07] blur-[130px]"
  >
  </div>

  <!-- Nav -->
  <nav class="relative mx-auto flex max-w-6xl items-center justify-between gap-3 px-5 py-5 sm:px-6">
    <a href="#" class="group flex items-center gap-3">
      <span
        class="flex h-10 w-10 items-center justify-center rounded-xl bg-acid p-1 transition group-hover:scale-105"
      >
        <img src="/logo-mark.png" alt="Vapes Skull Gv" class="h-full w-full object-contain" />
      </span>
      <span class="font-display text-base uppercase tracking-wide sm:text-lg">
        {siteConfig.nombre}
      </span>
    </a>

    <div class="flex items-center gap-2">
      <a
        href={`https://wa.me/${siteConfig.whatsapp}`}
        target="_blank"
        rel="noopener"
        class="rounded-xl border border-line px-4 py-2.5 text-sm font-semibold text-bone/80 transition hover:border-acid/45 hover:text-bone"
      >
        Contactar
      </a>
      <ThemeToggle />
    </div>
  </nav>

  <!-- Hero -->
  <div class="relative mx-auto max-w-4xl px-5 pb-14 pt-8 text-center sm:px-6 md:pb-20 md:pt-12">
    <!-- Logo grande -->
    <div
      class="animate-fadeUp mx-auto mb-7 flex h-28 w-28 items-center justify-center rounded-[1.75rem] bg-acid p-4 shadow-glow md:h-36 md:w-36 md:p-5"
    >
      <img src="/logo-mark.png" alt="Vapes Skull Gv" class="h-full w-full object-contain" />
    </div>

    <p
      class="animate-fadeUp mb-6 inline-flex items-center gap-2 rounded-full border border-line px-4 py-1.5 text-[11px] font-semibold uppercase tracking-[0.18em] text-bone/50"
      style="animation-delay: 80ms"
    >
      <span class="h-1.5 w-1.5 rounded-full bg-acid"></span>
      Catálogo privado · Entrega discreta
    </p>

    <h1
      class="animate-fadeUp font-display text-[2.75rem] uppercase leading-[0.9] tracking-tight sm:text-6xl md:text-7xl"
      style="animation-delay: 130ms"
    >
      <span class="bg-gradient-to-b from-acid-soft to-acid-deep bg-clip-text text-transparent">
        {siteConfig.nombre}
      </span>
    </h1>

    <p
      class="animate-fadeUp mx-auto mt-6 max-w-lg text-base leading-relaxed text-bone/55 md:text-lg"
      style="animation-delay: 200ms"
    >
      {siteConfig.tagline} · Pide por WhatsApp y recibe tu producto sin complicaciones.
    </p>

    <div class="animate-fadeUp mt-9 flex flex-wrap justify-center gap-3" style="animation-delay: 240ms">
      <a
        href="#catalogo"
        class="group inline-flex items-center gap-2 rounded-xl bg-acid px-7 py-3.5 font-bold text-onacid transition hover:brightness-105"
      >
        Ver catálogo
        <span class="transition group-hover:translate-y-0.5">↓</span>
      </a>
    </div>

    <!-- Stats -->
    <div
      class="animate-fadeUp mx-auto mt-14 grid max-w-md grid-cols-2 gap-3 border-t border-line pt-8"
      style="animation-delay: 320ms"
    >
      <div>
        <p class="font-display text-3xl text-accent md:text-4xl">{totalProductos}</p>
        <p class="mt-1 text-[10px] uppercase tracking-[0.18em] text-bone/40">Productos</p>
      </div>
      <div class="border-l border-line">
        <p class="font-display text-3xl text-accent md:text-4xl">24/7</p>
        <p class="mt-1 text-[10px] uppercase tracking-[0.18em] text-bone/40">Atención</p>
      </div>
    </div>
  </div>

  <!-- Marquee de marcas -->
  <div class="relative border-y border-line py-4">
    <div class="flex w-max animate-marquee gap-12 whitespace-nowrap">
      {[...marcas, ...marcas].map((m) => (
        <span class="font-display text-sm uppercase tracking-[0.2em] text-bone/20">{m}</span>
      ))}
    </div>
  </div>
</header>
