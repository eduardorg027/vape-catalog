<div
  id="age-gate"
  class="fixed inset-0 z-[60] flex items-center justify-center bg-overlay p-4 backdrop-blur-xl"
>
  <div class="relative w-full max-w-md overflow-hidden rounded-3xl border border-line bg-surface p-8 text-center">
    <div class="relative">
      <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-acid p-2">
        <img src="/logo-mark.png" alt="Vapes Skull Gv" class="h-full w-full object-contain" />
      </div>
      <h2 class="mt-5 font-display text-2xl uppercase tracking-tight">Verificación de edad</h2>
      <p class="mt-2 text-sm leading-relaxed text-bone/55">
        Este catálogo contiene productos de vapeo destinados
        <strong class="text-bone/85">exclusivamente a mayores de 18 años</strong>.
      </p>

      <div class="mt-7 flex flex-col gap-3">
        <button
          id="age-yes"
          class="w-full rounded-xl bg-acid px-4 py-3.5 font-bold text-onacid transition hover:brightness-105"
        >
          Sí, soy mayor de 18
        </button>
        <a
          href="https://google.com"
          class="w-full rounded-xl border border-line px-4 py-3 text-sm font-semibold text-bone/60 transition hover:text-bone/85"
        >
          Salir
        </a>
      </div>

      <p class="mt-5 text-[11px] uppercase tracking-widest text-bone/30">
        Producto con nicotina · Adictivo
      </p>
    </div>
  </div>
</div>

<script>
  const gate = document.getElementById('age-gate');
  const yes = document.getElementById('age-yes');
  if (localStorage.getItem('age-ok') === '1') {
    gate?.remove();
  } else {
    document.body.style.overflow = 'hidden';
  }
  yes?.addEventListener('click', () => {
    localStorage.setItem('age-ok', '1');
    gate?.remove();
    document.body.style.overflow = '';
  });
</script>
