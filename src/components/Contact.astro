---
import { siteConfig } from '../data/config.js';
---

<section class="relative overflow-hidden py-20">
  <div class="pointer-events-none absolute inset-x-0 top-1/2 h-64 -translate-y-1/2 bg-neon/10 blur-3xl"></div>
  <div class="relative mx-auto max-w-2xl px-6 text-center">
    <h2 class="text-3xl font-black md:text-4xl">¿Te interesa algo?</h2>
    <p class="mt-3 text-white/50">Escríbeme por privado y te confirmo disponibilidad y entrega al momento.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a
        href={`https://wa.me/${siteConfig.whatsapp}`}
        target="_blank"
        rel="noopener"
        class="rounded-xl bg-gradient-to-r from-neon to-aqua px-8 py-3 font-bold text-night shadow-lg shadow-neon/25 transition hover:scale-105"
      >
        💬 WhatsApp
      </a>
      <a
        href={siteConfig.instagram}
        target="_blank"
        rel="noopener"
        class="rounded-xl border border-white/15 bg-white/5 px-8 py-3 font-semibold transition hover:bg-white/10"
      >
        📸 Instagram
      </a>
    </div>
  </div>
</section>
