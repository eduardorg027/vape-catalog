---
import { siteConfig } from '../data/config.js';
---

<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-20">
  <div class="relative overflow-hidden rounded-3xl border border-line bg-surface/60 px-6 py-14 text-center md:px-12">
    <div
      class="pointer-events-none absolute left-1/2 top-0 h-40 w-[30rem] -translate-x-1/2 rounded-full bg-acid/[0.06] blur-[100px]"
    >
    </div>

    <div class="relative mx-auto max-w-xl">
      <p class="text-[11px] font-bold uppercase tracking-[0.25em] text-accent">Contacto</p>
      <h2 class="mt-3 font-display text-3xl uppercase leading-tight tracking-tight md:text-4xl">
        ¿Te interesa algo?
      </h2>
      <p class="mt-4 text-sm leading-relaxed text-bone/55 md:text-base">
        Escríbeme directo y te confirmo disponibilidad, precio final y entrega al momento.
      </p>

      <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
        <a
          href={`https://wa.me/${siteConfig.whatsapp}`}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-acid px-7 py-3.5 font-bold text-onacid transition hover:brightness-105"
        >
          💬 WhatsApp
        </a>
        <a
          href={siteConfig.instagram}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center justify-center gap-2 rounded-xl border border-line px-7 py-3.5 font-semibold text-bone/80 transition hover:border-acid/45 hover:text-bone"
        >
          📸 Instagram
        </a>
      </div>

      <p class="mt-7 text-[11px] uppercase tracking-widest text-bone/30">
        Respuesta rápida · Envío discreto · Pago seguro
      </p>
    </div>
  </div>
</section>
